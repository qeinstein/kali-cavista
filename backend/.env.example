
# Application
APP_NAME=your-app-name
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me

# Database (example values)
# Use an asyncpg URL for runtime and psycopg2 URL for Alembic migrations
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_MIGRATION_URL=postgresql+psycopg2://user:password@host:5432/dbname

# External APIs
OPENWEATHER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
GROQ_API_KEY=
ELEVENLABS_API_KEY=
TTS_SERVICE=elevenlabs
ELEVENLABS_VOICE_ID=

# API Configuration
API_URL=http://localhost:8000
API_VERSION=v1

